# Copy to .env (never commit .env). No real secrets in this file.
CLIENT_ID=BDDDE967BCF943098B8A44E164AE1A74
CLIENT_SECRET=dwNP-S906VwNn1c9rBYHWfqg2bxXktwQ-oAUIm_NlHzMbpsa

# --- existing behaviour (defaults shown) ---
XERO_REDIRECT_URI=http://localhost:5000/callback
# XERO_SCOPES=offline_access accounting.transactions accounting.contacts
# XERO_TOKEN_FILE=xero_tokens.json

# --- security (recommended for any deployment) ---
# Long random string. REQUIRED when allocation removal is enabled.
SECRET_KEY=
# Any passphrase; encrypts xero_tokens.json at rest. Keep it stable, losing it means reconnecting to Xero.
TOKEN_ENCRYPTION_KEY=
# Set true when served over HTTPS
# SESSION_COOKIE_SECURE=true

# --- Allocation Removal (DISABLED by default) ---
ENABLE_ALLOCATION_REMOVAL=false
# Optional: comma-separated Xero tenant IDs where removal is allowed (empty = any connected org)
# REMOVAL_ALLOWED_TENANT_IDS=
# ALLOCATION_AUDIT_LOG=allocation_removal_audit.log
# MAX_XERO_PAGES=25
